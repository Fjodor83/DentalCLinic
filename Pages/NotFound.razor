@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found - Oceanside Dental Centre</PageTitle>

<section class="section-sand min-vh-100 d-flex align-items-center py-5">
    <div class="container text-center">
        <div class="mb-4">
            <i class="ti ti-alert-circle text-ocean" style="font-size: 5rem; opacity: 0.8;" aria-hidden="true"></i>
        </div>
        
        <h1 class="display-1 fw-bold text-ocean mb-3" style="letter-spacing: -2px;">404</h1>
        <h2 class="h3 mb-4 fw-medium text-dark">Oops! We can't find that page</h2>
        <p class="lead text-muted mx-auto mb-5" style="max-width: 600px;">
            The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. Let's get you back to a healthy smile.
        </p>

        <div class="row justify-content-center g-4 mb-5">
            <div class="col-md-4 col-sm-6">
                <a href="" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 card-ocean hover-lift">
                        <div class="card-body p-4 text-center">
                            <i class="ti ti-home fs-1 text-aqua mb-3 d-block"></i>
                            <h5 class="card-title fw-bold text-dark">Home Page</h5>
                            <p class="card-text small text-muted mb-0">Return to our main page</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a href="services" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 card-ocean hover-lift">
                        <div class="card-body p-4 text-center">
                            <i class="ti ti-stethoscope fs-1 text-aqua mb-3 d-block"></i>
                            <h5 class="card-title fw-bold text-dark">Our Services</h5>
                            <p class="card-text small text-muted mb-0">Explore dental treatments</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a href="contact" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 card-ocean hover-lift">
                        <div class="card-body p-4 text-center">
                            <i class="ti ti-calendar-event fs-1 text-aqua mb-3 d-block"></i>
                            <h5 class="card-title fw-bold text-dark">Book Now</h5>
                            <p class="card-text small text-muted mb-0">Schedule an appointment</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <div class="text-muted small">
            Need immediate assistance? Call us at <a href="tel:2505864404" class="text-ocean fw-bold text-decoration-none">250.586.4404</a>
        </div>
    </div>
</section>
