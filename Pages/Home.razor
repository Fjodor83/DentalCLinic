@page "/"

<PageTitle>Home - Oceanside Dental Centre</PageTitle>
<HeadContent>
    <meta name="description" content="Oceanside Dental Centre in Parksville, BC offers family and cosmetic dentistry: cleanings, implants, crowns, whitening, laser therapy and more." />
    <link rel="canonical" href="https://www.oceansidedentalcentre.com/" />
</HeadContent>

<!-- Hero Section — split layout -->
<section class="hero-ocean hero-split">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <p class="hero-eyebrow">Parksville, British Columbia</p>
                <h1 class="display-4 mb-3">Exceptional dental care, delivered with calm and precision</h1>
                <p class="lead fs-5 mb-4">Family and cosmetic dentistry in the heart of Oceanside — where modern technology meets a gentle, patient-first approach.</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="contact" class="btn btn-ocean btn-lg">Book an Appointment</a>
                    <a href="clinic" class="btn btn-outline-light btn-lg">Explore the Clinic</a>
                </div>
                <ul class="hero-trust">
                    <li><i class="ti ti-rosette-discount-check" aria-hidden="true"></i> Now accepting new patients</li>
                    <li><i class="ti ti-clock" aria-hidden="true"></i> Direct insurance billing</li>
                    <li><i class="ti ti-heart" aria-hidden="true"></i> Gentle, family-friendly care</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="hero-media">
                    <img src="images/home-hero.jpg" alt="Welcoming treatment room at Oceanside Dental Centre"
                         width="1024" height="473" decoding="async" fetchpriority="high" />
                </div>
            </div>
        </div>
    </div>
</section>

