@page "/services"

<PageTitle>Our Services - Oceanside Dental Centre</PageTitle>

<!-- Page Header -->
<div class="bg-ocean-gradient text-white py-3 mb-5">
    <div class="container">
        <div class="text-center">
            <h1 class="h3 m-0">Our Services</h1>
        </div>
    </div>
</div>

<div class="container mb-5">
    
    <!-- Intro -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8 text-center">
            <p class="lead text-muted">
                At Oceanside Dental Centre, we offer a comprehensive range of dental services 
                to meet all your oral health needs. From preventive care to cosmetic dentistry, 
                our experienced team is here to help you achieve a healthy, beautiful smile.
            </p>
        </div>
    </div>

    <!-- Hygiene Services -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-ocean-gradient text-white py-3">
                    <h2 class="h4 m-0">
                        <i class="ti ti-tooth align-middle me-2" aria-hidden="true"></i>
                        Hygiene Services
                    </h2>
                    <small class="fst-italic">"Comprehensive Hygiene Services for your overall health and wellness"</small>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    Dental Cleanings & check-ups
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    Oral cancer screening
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    Preventative Hygiene
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    Restorative, deep pocket cleaning
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/laser-therapy" class="text-decoration-none">Laser therapy</a> & Cavitron treatments
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="service/hygiene" class="btn btn-outline-ocean btn-sm">Learn More About Hygiene</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Restorative Services -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary-custom text-white py-3">
                    <h2 class="h4 m-0">
                        <i class="ti ti-tools align-middle me-2" aria-hidden="true"></i>
                        Restorative Services
                    </h2>
                    <small class="fst-italic">"When it's needed"</small>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-4">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/composite-restorations" class="text-decoration-none">White fillings</a>
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/crowns" class="text-decoration-none">Crowns</a>
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/bridges" class="text-decoration-none">Bridges</a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-4">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/implant-restoration" class="text-decoration-none">Implants</a> & <a href="service/mini-implants" class="text-decoration-none">Mini-implants</a>
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/endo-therapy" class="text-decoration-none">Root Canal therapy</a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-4">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/extractions" class="text-decoration-none">Extractions</a> (with on-site surgeon)
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    Sedation by pre-arrangement
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cosmetic Services -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary-custom text-white py-3">
                    <h2 class="h4 m-0">
                        <i class="ti ti-sparkles align-middle me-2" aria-hidden="true"></i>
                        Cosmetic Services
                    </h2>
                    <small class="fst-italic">"Because you're worth a beautiful smile"</small>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/cosmetic-veneers" class="text-decoration-none">Veneers</a>
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/crowns" class="text-decoration-none">Crowns</a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/whitening" class="text-decoration-none">ZOOM Laser Teeth whitening</a>
                                </li>
                                <li class="mb-2">
                                    <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                                    <a href="service/whitening" class="text-decoration-none">Take home Bleaching Kits</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Children & Seniors -->
    <div class="row mb-5">
        <div class="col-md-6 mb-4 mb-md-0">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary-custom text-white py-3">
                    <h2 class="h5 m-0">
                        <i class="ti ti-baby-carriage align-middle me-2" aria-hidden="true"></i>
                        Children's Dentistry
                    </h2>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-3">
                        <li class="mb-2">
                            <span class="material-icons text-aqua align-middle me-2 mi-sm" aria-hidden="true">check_circle</span>
                            We are a <a href="service/healthy-kids" class="text-decoration-none fw-bold">"Healthy Kids"</a> office
                        </li>
                        <li class="mb-2">
                            <span class="material-icons text-aqua align-middle me-2 mi-sm" aria-hidden="true">check_circle</span>
                            <a href="service/sealants" class="text-decoration-none">Dental Sealants</a> for cavity prevention
                        </li>
                        <li class="mb-2">
                            <span class="material-icons text-aqua align-middle me-2 mi-sm" aria-hidden="true">check_circle</span>
                            Check-ups & Cleanings
                        </li>
                        <li class="mb-2">
                            <span class="material-icons text-aqua align-middle me-2 mi-sm" aria-hidden="true">check_circle</span>
                            Preventative approach to a smile for life
                        </li>
                    </ul>
                    <a href="service/child-first-visit" class="btn btn-outline-ocean btn-sm">Child's First Visit</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary-custom text-white py-3">
                    <h2 class="h5 m-0">
                        <i class="ti ti-old align-middle me-2" aria-hidden="true"></i>
                        Senior's Dentistry
                    </h2>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-3">
                        <li class="mb-2">
                            <span class="material-icons text-aqua align-middle me-2 mi-sm" aria-hidden="true">check_circle</span>
                            Full & Partial Dentures
                        </li>
                        <li class="mb-2">
                            <span class="material-icons text-aqua align-middle me-2 mi-sm" aria-hidden="true">check_circle</span>
                            <a href="service/mini-implants" class="text-decoration-none">Mini-implants</a> for lower teeth
                        </li>
                        <li class="mb-2">
                            <i class="ti ti-circle-check text-aqua align-middle me-2" aria-hidden="true"></i>
                            Cleanings & restorative service
                        </li>
                        <li class="mb-2">
                            <i class="ti ti-discount-2 text-aqua align-middle me-2" aria-hidden="true"></i>
                            <strong class="text-aqua">10% Senior Special Discount</strong> on all services!
                        </li>
                    </ul>
                    <a href="service/children-seniors" class="btn btn-outline-ocean btn-sm">Learn More</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Services -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-ocean-gradient text-white py-3">
                    <h2 class="h4 m-0">
                        <i class="ti ti-stethoscope align-middle me-2" aria-hidden="true"></i>
                        Additional Services
                    </h2>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <a href="service/tmj-pain" class="text-decoration-none">
                                <div class="service-grid-item">
                                    <i class="ti ti-brain text-aqua mb-2" aria-hidden="true"></i>
                                    <h5 class="text-dark">TMJ / Jaw Pain</h5>
                                    <small class="text-muted">Treatment for jaw and headache pain</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a href="service/laser-therapy" class="text-decoration-none">
                                <div class="service-grid-item">
                                    <i class="ti ti-bolt text-aqua mb-2" aria-hidden="true"></i>
                                    <h5 class="text-dark">Laser Therapy</h5>
                                    <small class="text-muted">Advanced laser gum treatment</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a href="service/sealants" class="text-decoration-none">
                                <div class="service-grid-item">
                                    <i class="ti ti-shield text-aqua mb-2" aria-hidden="true"></i>
                                    <h5 class="text-dark">Pit & Fissure Sealants</h5>
                                    <small class="text-muted">Preventive protection for teeth</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="row">
        <div class="col-12">
            <div class="text-center p-5 bg-light rounded shadow-sm">
                <h3 class="mb-3 text-ocean">Have Questions About Our Services?</h3>
                <p class="text-muted mb-4">
                    Please contact us if you have any questions or would like to request a procedure not listed above.
                </p>
                <a href="contact" class="btn btn-primary-custom text-white px-4 py-2">
                    <i class="ti ti-phone align-middle me-1" aria-hidden="true"></i>
                    Contact Us Today
                </a>
            </div>
        </div>
    </div>

</div>
